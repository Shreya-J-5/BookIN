# BookIN Application Environment Variables

APP_NAME=BookIN
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL is the single primary database)
# Default for Docker Compose: postgresql+psycopg://bookin_user:bookin_password@postgres:5432/bookin_db
# For local development with PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/bookin_db
# For local development without active PostgreSQL daemon: sqlite+aiosqlite:///./bookin.db
DATABASE_URL=postgresql+psycopg://bookin_user:bookin_password@localhost:5432/bookin_db
ASYNC_DATABASE_URL=postgresql+asyncpg://bookin_user:bookin_password@localhost:5432/bookin_db

# Redis (Caching, Pub/Sub, and Celery broker)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Seat Reservation Engine
SEAT_LOCK_DURATION_MINUTES=10

# Razorpay Payment Gateway (Test credentials or leave empty for mock/sandbox)
RAZORPAY_KEY_ID=rzp_test_bookin_mock_key
RAZORPAY_KEY_SECRET=rzp_test_bookin_mock_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_bookin

# Email Notifications (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=notifications@bookin.example.com
EMAIL_PASSWORD=app_specific_password_here
EMAIL_FROM=BookIN Tickets <notifications@bookin.example.com>

# Super Admin Bootstrap (Initial seed credentials)
SUPERADMIN_EMAIL=admin@bookin.com
SUPERADMIN_PASSWORD=Admin@BookIN2026!
SUPERADMIN_NAME=BookIN Super Administrator

